#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f /etc/arch-release ]]; then
  echo "Not an Arch Linux system; skipping pacman bootstrap."
  exit 0
fi

if (( EUID == 0 )); then
  sudo_cmd=()
else
  if ! command -v sudo >/dev/null; then
    echo "sudo is required for package installation. Install sudo or run chezmoi as root." >&2
    exit 1
  fi
  sudo_cmd=(sudo)
fi

user_name="{{ .chezmoi.username }}"

official_packages=(
  chezmoi
  git
  sudo
  base-devel
  linux-firmware
  mesa
  vulkan-intel
  intel-media-driver

  hyprland
  waybar
  wofi
  foot
  fish
  hyprlock
  hypridle
  hyprpaper
  hyprpolkitagent
  xdg-desktop-portal-hyprland
  xdg-desktop-portal-gtk
  qt5-wayland
  qt6-wayland
  qt5ct
  qt6ct
  kvantum
  kvantum-qt5
  breeze
  plasma-integration

  pipewire
  pipewire-pulse
  wireplumber
  alsa-utils
  pamixer
  playerctl
  pavucontrol

  networkmanager
  network-manager-applet
  bluez
  bluez-utils
  blueman
  mako
  libnotify
  wl-clipboard
  cliphist
  grim
  slurp
  swappy
  brightnessctl

  dolphin
  kde-cli-tools
  xdg-utils
  xdg-user-dirs
  papirus-icon-theme
  adw-gtk-theme
  noto-fonts
  noto-fonts-cjk
  noto-fonts-extra
  noto-fonts-emoji
  ttf-hack-nerd
  ttf-firacode-nerd
  ttf-jetbrains-mono-nerd
  nwg-look

  eza
  bat
  zoxide
  ripgrep
  fd
  fzf
  btop
  fastfetch
  lazygit
  dust
  duf
  fnm
  firefox

  dbeaver
  docker
  docker-compose
  docker-buildx

  pacman-contrib
  reflector
  openssh
  rsync
  sshfs
  pass
  proxychains-ng
  iptables
  curl
  wget
  unzip
  zip
  man-db
  man-pages
  less
  power-profiles-daemon
  ufw
)

aur_packages=(
  google-chrome
  visual-studio-code-bin
  redisinsight
)

install_paru() {
  if command -v paru >/dev/null; then
    return
  fi

  if (( EUID == 0 )); then
    echo "paru is missing and cannot be built as root; skipping AUR package installation." >&2
    return
  fi

  local build_dir
  build_dir="$(mktemp -d)"
  trap 'rm -rf "$build_dir"; trap - RETURN' RETURN

  git clone https://aur.archlinux.org/paru.git "$build_dir/paru"
  (cd "$build_dir/paru" && makepkg -si --needed --noconfirm)
}

bootstrap_fnm_node() {
  if ! command -v fnm >/dev/null; then
    return
  fi

  export FNM_DIR="${FNM_DIR:-$HOME/.local/share/fnm}"
  eval "$(fnm env --shell bash)"

  if ! fnm ls 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^v?[0-9]+\./) found = 1 } END { exit found ? 0 : 1 }'; then
    fnm install --lts --use --corepack-enabled
  fi

  if ! fnm default >/dev/null 2>&1; then
    current_node="$(fnm current 2>/dev/null || true)"
    if [[ -n "$current_node" && "$current_node" != "none" ]]; then
      fnm default "$current_node" || true
    fi
  fi
}

"${sudo_cmd[@]}" pacman -Syu --needed --noconfirm "${official_packages[@]}"

install_paru

if command -v paru >/dev/null; then
  if pacman -Qq code >/dev/null 2>&1 && ! pacman -Qq visual-studio-code-bin >/dev/null 2>&1; then
    "${sudo_cmd[@]}" pacman -Rns --noconfirm code || true
  fi
  paru -S --needed --noconfirm "${aur_packages[@]}"
else
  echo "paru is unavailable; skipped AUR packages: ${aur_packages[*]}" >&2
fi

"${sudo_cmd[@]}" systemctl enable --now NetworkManager.service
"${sudo_cmd[@]}" systemctl enable --now bluetooth.service || true
"${sudo_cmd[@]}" systemctl enable --now fstrim.timer || true
"${sudo_cmd[@]}" systemctl enable --now power-profiles-daemon.service || true
"${sudo_cmd[@]}" systemctl enable --now docker.service || true

if command -v ufw >/dev/null; then
  "${sudo_cmd[@]}" ufw default deny incoming || true
  "${sudo_cmd[@]}" ufw default allow outgoing || true
  "${sudo_cmd[@]}" systemctl enable --now ufw.service || true
fi

if id "$user_name" >/dev/null 2>&1; then
  "${sudo_cmd[@]}" groupadd -f docker || true
  for group in docker video input; do
    if getent group "$group" >/dev/null; then
      "${sudo_cmd[@]}" usermod -aG "$group" "$user_name" || true
    fi
  done
  if command -v fish >/dev/null && grep -q '^/usr/bin/fish$' /etc/shells; then
    current_shell="$(getent passwd "$user_name" | cut -d: -f7)"
    if [[ "$current_shell" != "/usr/bin/fish" ]]; then
      "${sudo_cmd[@]}" chsh -s /usr/bin/fish "$user_name" || true
    fi
  fi
fi

bootstrap_fnm_node

cat <<'EOF'

Docker is installed and docker.service is enabled.
To use docker without sudo in your current shell, log out and back in or run:
  newgrp docker

EOF
